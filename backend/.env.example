# Q-Compass backend configuration
# Copy to `.env` and adjust as needed. All values are optional.

ENVIRONMENT=development
APP_NAME=Q-Compass API
APP_VERSION=0.1.0

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=26214400
STORE_MAX_ITEMS=50

# --- Analysis engine budgets (see services/README.md#configuration) ---------
# Rows read from disk; larger files are sampled and flagged in the response.
ANALYSIS_MAX_ROWS=20000
# Rows used for model fitting.
ANALYSIS_MAX_TRAIN_ROWS=20000
# Random forest budget - we want a baseline, not a tuned best-in-class result.
ANALYSIS_FOREST_TREES=200
ANALYSIS_FOREST_MAX_DEPTH=12
ANALYSIS_CV_FOLDS=3
# An RBF SVM is O(n^2 * d); above these limits it is skipped entirely.
ANALYSIS_SVM_MAX_ROWS=5000
ANALYSIS_SVM_MAX_FEATURES=200
# Every sampler and estimator, so the same file always gives the same numbers.
ANALYSIS_RANDOM_SEED=42
# Qubit budget assumed addressable by publicly available devices.
QUANTUM_REFERENCE_QUBITS=127
