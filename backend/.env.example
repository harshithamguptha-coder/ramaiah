# Q-Compass backend configuration
# Copy to `.env` and adjust as needed. All values are optional.

ENVIRONMENT=development
APP_NAME=Q-Compass API
APP_VERSION=0.1.0

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=26214400
STORE_MAX_ITEMS=50
